# Server Configuration (mcp-service-kit)
# Transport: stdio or http. --mode on the command line overrides it.
# MCP_TRANSPORT=stdio
MCP_HOST=localhost
MCP_PORT=3000
# No auth provider is configured, so HTTP mode needs --no-auth (or this set to false);
# otherwise mcp-service-kit refuses to start.
# MCP_AUTH_ENABLED=false

# Bible API Configuration
# BIBLE_API_URL=https://www.biblegateway.com/passage/
# BIBLE_DEFAULT_VERSION=ESV
# BIBLE_TIMEOUT=30
